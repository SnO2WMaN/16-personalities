{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":dependencyDashboard",
		":automergeMinor",
		"schedule:monthly"
	],
	"timezone": "Asia/Tokyo",
	"rebaseWhen": "conflicted",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 3am on the first day of the month"]
	},
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"groupName": "all non-major dependencies"
		}
	]
}
